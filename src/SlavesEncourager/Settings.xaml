<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource settings.title}" Width="660" Height="755" MinWidth="600" MinHeight="580" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,6,0,13"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemFace" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFace" Property="Background" Value="{DynamicResource SurfaceAlt}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFace" Property="Background" Value="{DynamicResource SurfaceAlt}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Padding" Value="10,9"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,6,0,13"/><Setter Property="MinHeight" Value="36"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8"><Grid><ContentPresenter/><TextBlock Text="⌄" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,2" Foreground="{DynamicResource Muted}"/></Grid></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter Margin="11,9,30,9" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="9" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280" CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,6,15,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabFace" Background="{DynamicResource Surface}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,6,10"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFace" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><Border Grid.Row="1" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="16"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource settings.headline}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource settings.previewHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,16"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource language.label}" FontSize="10" Foreground="{DynamicResource Muted}"/><ComboBox x:Name="LanguageBox" FontSize="11"><ComboBoxItem Content="{DynamicResource language.auto}" Tag="auto"/><ComboBoxItem Content="简体中文" Tag="zh-Hans"/><ComboBoxItem Content="繁體中文" Tag="zh-Hant"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="日本語" Tag="ja"/><ComboBoxItem Content="Español" Tag="es"/><ComboBoxItem Content="한국어" Tag="ko"/></ComboBox></StackPanel></Grid>
  <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="13" Padding="14,8" Margin="0,0,0,16"><Grid x:Name="PreviewHost" Height="85"/></Border>
  <TabControl x:Name="SettingsTabs" Grid.Row="2" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource Stroke}" Padding="16">
   <TabItem Header="{DynamicResource tab.appearance}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{DynamicResource appearance.animation}"/><ComboBox x:Name="AnimationBox"><ComboBoxItem Content="{DynamicResource animation.flip}" Tag="flip"/><ComboBoxItem Content="{DynamicResource animation.slide}" Tag="slide"/><ComboBoxItem Content="{DynamicResource animation.none}" Tag="none"/></ComboBox>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{DynamicResource appearance.theme}"/><ComboBox x:Name="ThemeBox"><ComboBoxItem Content="{DynamicResource theme.mist}" Tag="midnight"/><ComboBoxItem Content="{DynamicResource theme.dusk}" Tag="forest"/><ComboBoxItem Content="{DynamicResource theme.paper}" Tag="paper"/></ComboBox></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource appearance.font}"/><ComboBox x:Name="FontBox"><ComboBoxItem Content="{DynamicResource font.din}" Tag="DIN"/><ComboBoxItem Content="{DynamicResource font.mono}" Tag="Mono"/><ComboBoxItem Content="{DynamicResource font.classic}" Tag="Classic"/></ComboBox></StackPanel>
    </Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{DynamicResource appearance.decimals}"/><ComboBox x:Name="DecimalsBox"><ComboBoxItem Content="{DynamicResource precision.0}" Tag="0"/><ComboBoxItem Content="{DynamicResource precision.1}" Tag="1"/><ComboBoxItem Content="{DynamicResource precision.2}" Tag="2"/><ComboBoxItem Content="{DynamicResource precision.3}" Tag="3"/><ComboBoxItem Content="{DynamicResource precision.4}" Tag="4"/></ComboBox></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource appearance.currency}"/><ComboBox x:Name="CurrencyBox"><ComboBoxItem Content="{DynamicResource currency.cny}" Tag="CNY"/><ComboBoxItem Content="{DynamicResource currency.usd}" Tag="USD"/><ComboBoxItem Content="{DynamicResource currency.eur}" Tag="EUR"/><ComboBoxItem Content="{DynamicResource currency.jpy}" Tag="JPY"/></ComboBox></StackPanel>
    </Grid>
    <CheckBox x:Name="GroupingBox" Content="{DynamicResource appearance.grouping}"/>
    <TextBlock Text="{DynamicResource appearance.layout}"/><ComboBox x:Name="PatternBox"><ComboBoxItem Content="{DynamicResource pattern.prefix}" Tag="{}{symbol}{amount}"/><ComboBoxItem Content="{DynamicResource pattern.code}" Tag="{}{amount} {code}"/><ComboBoxItem Content="{DynamicResource pattern.number}" Tag="{}{amount}"/><ComboBoxItem Content="{DynamicResource pattern.custom}" Tag="custom"/></ComboBox>
    <TextBlock Text="{DynamicResource pattern.label}"/><TextBox x:Name="PatternText" MaxLength="48"/><TextBlock Text="{DynamicResource pattern.help}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,-6,0,14"/>
    <TextBlock Text="{DynamicResource appearance.speed}"/><ComboBox x:Name="SpeedBox"><ComboBoxItem Content="{DynamicResource speed.fast}" Tag="220"/><ComboBoxItem Content="{DynamicResource speed.normal}" Tag="420"/><ComboBoxItem Content="{DynamicResource speed.slow}" Tag="650"/></ComboBox>
    <TextBlock Text="{DynamicResource currency.help}" Foreground="{DynamicResource Muted}" FontSize="10"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{DynamicResource tab.salary}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{DynamicResource salary.amount}"/><TextBox x:Name="SalaryText" MaxLength="16"/>
    <TextBlock Text="{DynamicResource salary.basis}"/><ComboBox x:Name="BasisBox"><ComboBoxItem Content="{DynamicResource basis.actual}" Tag="actual"/><ComboBoxItem Content="{DynamicResource basis.fixed}" Tag="fixed"/></ComboBox>
    <TextBlock Text="{DynamicResource salary.settlement}"/><ComboBox x:Name="SettlementBox"/>
    <TextBlock Text="{DynamicResource salary.cycleHelp}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,-6,0,14"/>
    <Button x:Name="AdjustIncomeButton" Content="{DynamicResource income.adjust}" HorizontalAlignment="Left" Margin="0,0,0,5"/>
    <TextBlock x:Name="IncomeAdjustmentHint" Text="{DynamicResource income.adjustHint}" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
    <CheckBox x:Name="ExpensesEnabledBox" Content="{DynamicResource expense.enable}" Margin="0,0,0,5"/>
    <Button x:Name="OpenExpensesButton" Content="{DynamicResource expense.edit}" HorizontalAlignment="Left" Margin="0,0,0,14" IsEnabled="False"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{DynamicResource salary.start}"/><TextBox x:Name="StartText" MaxLength="5"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource salary.end}"/><TextBox x:Name="EndText" MaxLength="5"/></StackPanel>
    </Grid>
    <CheckBox x:Name="LunchBox" Content="{DynamicResource salary.breakEnabled}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{DynamicResource salary.breakStart}"/><TextBox x:Name="LunchStartText" MaxLength="5"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource salary.breakEnd}"/><TextBox x:Name="LunchEndText" MaxLength="5"/></StackPanel>
    </Grid>
    <TextBlock Text="{DynamicResource salary.weekdays}"/><WrapPanel Margin="0,7,0,8"><CheckBox x:Name="Day1" Content="{DynamicResource weekday.mon}"/><CheckBox x:Name="Day2" Content="{DynamicResource weekday.tue}"/><CheckBox x:Name="Day3" Content="{DynamicResource weekday.wed}"/><CheckBox x:Name="Day4" Content="{DynamicResource weekday.thu}"/><CheckBox x:Name="Day5" Content="{DynamicResource weekday.fri}"/><CheckBox x:Name="Day6" Content="{DynamicResource weekday.sat}"/><CheckBox x:Name="Day0" Content="{DynamicResource weekday.sun}"/></WrapPanel>
    <Button x:Name="OpenCalendarButton" Content="{DynamicResource calendar.open}" HorizontalAlignment="Left" Margin="0,3,0,14"/>
    <TextBlock Text="{DynamicResource salary.help}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{DynamicResource tab.calendar}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="CalendarHost" Height="350"/></ScrollViewer></TabItem>
   <TabItem Header="{DynamicResource tab.goals}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Grid Margin="0,0,0,12"><TextBlock Text="{DynamicResource goal.listTitle}" FontSize="16" VerticalAlignment="Center"/><Button x:Name="AddGoalButton" Content="{DynamicResource goal.add}" HorizontalAlignment="Right"/></Grid>
    <TextBlock Text="{DynamicResource goal.allocationHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
    <StackPanel x:Name="GoalsHost"/>
    <TextBlock Text="{DynamicResource goal.estimateHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,22"/>
    <TextBlock Text="{DynamicResource help.title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="{DynamicResource help.drag}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="{DynamicResource help.shortcuts}" Margin="0,0,0,12"/>
    <TextBlock Text="{DynamicResource help.focus}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,12"/>
    <TextBlock Text="{DynamicResource help.tray}" Margin="0,0,0,12"/>
    <TextBlock Text="{DynamicResource help.demo}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="{DynamicResource help.local}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="ExpensesTab" Header="{DynamicResource expense.title}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Grid Margin="0,0,0,12"><TextBlock Text="{DynamicResource expense.listTitle}" FontSize="16" VerticalAlignment="Center"/><Button x:Name="AddExpenseButton" Content="{DynamicResource expense.add}" HorizontalAlignment="Right"/></Grid>
    <TextBlock Text="{DynamicResource expense.editorHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
    <StackPanel x:Name="ExpensesHost"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="StocksTab" Header="{DynamicResource tab.stocks}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{DynamicResource stock.tabTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <CheckBox x:Name="StocksEnabledBox" Content="{DynamicResource stock.enable}" Margin="0,0,0,10"/>
    <StackPanel x:Name="StockSettingsHost"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#F28E7D" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button x:Name="CancelButton" Content="{DynamicResource action.cancel}" IsCancel="True" Padding="20,9" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="{DynamicResource action.save}" IsDefault="True" Padding="22,9" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}"/></StackPanel>
 </Grid>
</Window>
