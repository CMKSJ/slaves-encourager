<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource app.name}" Width="548" Height="790" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize" Background="Transparent" AllowsTransparency="True" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#101716"/><SolidColorBrush x:Key="Surface" Color="#192321"/>
  <SolidColorBrush x:Key="SurfaceAlt" Color="#202E29"/><SolidColorBrush x:Key="Stroke" Color="#33423B"/>
  <SolidColorBrush x:Key="Ink" Color="#F3F3E9"/><SolidColorBrush x:Key="Muted" Color="#95A89D"/>
  <SolidColorBrush x:Key="Accent" Color="#DFEF9A"/><SolidColorBrush x:Key="AccentInk" Color="#172313"/>
  <SolidColorBrush x:Key="TileTop" Color="#2C3831"/><SolidColorBrush x:Key="TileBottom" Color="#253029"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.72"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.5"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Stroke}" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Kicker" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
 </Window.Resources>
 <Border x:Name="OuterBorder" CornerRadius="22" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Margin="6">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="DragBar" Background="Transparent" Margin="22,16,16,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image x:Name="BrandIcon" Width="30" Height="30" Margin="0,0,9,0"/>
     <TextBlock Tag="app.name" Text="{DynamicResource app.name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="ExpensesButton" Tag="main.expenses" Content="{DynamicResource main.expenses}" Visibility="Collapsed" Padding="8,5" Margin="0,0,5,0"/>
     <Button x:Name="PinButton" Content="{DynamicResource main.pin}" ToolTip="{DynamicResource main.pinTip}" Padding="8,5" Margin="0,0,5,0"/>
     <Button x:Name="MinimizeButton" Content="—" ToolTip="{DynamicResource main.hideTip}" BorderThickness="0" Padding="8,5"/>
     <Button x:Name="CloseButton" Content="×" ToolTip="{DynamicResource main.exitTip}" BorderThickness="0" Padding="8,5"/>
    </StackPanel>
   </Grid>
   <Viewbox x:Name="HomeFit" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="22,6,22,0">
    <StackPanel x:Name="HomeContent" Width="490">
     <StackPanel x:Name="IntroPanel" Margin="0,0,0,16">
      <Grid Margin="0,0,0,12"><TextBlock Tag="main.kicker" Text="{DynamicResource main.kicker}" Style="{StaticResource Kicker}" FontFamily="Bahnschrift"/>
       <TextBlock x:Name="DateText" Text="11.04 / WED" HorizontalAlignment="Right" Style="{StaticResource Kicker}" FontFamily="Bahnschrift"/></Grid>
      <TextBlock Tag="main.headline" Text="{DynamicResource main.headline}" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock x:Name="SubtitleText" Tag="main.subtitle" Text="{DynamicResource main.subtitle}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
     </StackPanel>
     <Border x:Name="HeroCard" CornerRadius="16" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="19,17,19,16">
      <StackPanel>
       <Grid>
        <TextBlock x:Name="AmountTitle" Tag="main.today" Text="{DynamicResource main.today}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" HorizontalAlignment="Right" Padding="9,4"><TextBlock x:Name="StatusText" Tag="main.demoBadge" Text="{DynamicResource main.demoBadge}" Foreground="{DynamicResource Accent}" FontSize="10"/></Border>
       </Grid>
       <Grid x:Name="FlipHost" Height="96" Margin="0,9,0,8"/>
       <Grid x:Name="RatePanel"><TextBlock x:Name="RateText" FontSize="11" Foreground="{DynamicResource Muted}" Tag="main.live" Text="{DynamicResource main.live}"/>
        <TextBlock x:Name="ModeText" Tag="main.live" Text="{DynamicResource main.live}" FontFamily="Bahnschrift" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Muted}"/></Grid>
      </StackPanel>
     </Border>
     <StackPanel x:Name="DetailPanel">
      <Border Margin="0,13,0,0" CornerRadius="15" Background="{DynamicResource Surface}" Padding="18,15">
       <StackPanel>
        <Grid><StackPanel><TextBlock x:Name="CountdownLabel" Tag="main.countdownOff" Text="{DynamicResource main.countdownOff}" Foreground="{DynamicResource Muted}" FontSize="11"/>
          <TextBlock x:Name="ScheduleText" Text="09:00 — 18:00" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
         <TextBlock x:Name="CountdownText" Text="03:28:19" FontFamily="Bahnschrift" FontSize="30" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <ProgressBar x:Name="WorkProgress" Height="4" Minimum="0" Maximum="100" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Stroke}" Margin="0,14,0,9"/>
        <Grid><TextBlock x:Name="HoursText" Tag="main.live" Text="{DynamicResource main.live}" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ProgressText" Text="53.6%" HorizontalAlignment="Right" FontFamily="Bahnschrift" FontSize="11" Foreground="{DynamicResource Accent}"/></Grid>
       </StackPanel>
      </Border>
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Background="{DynamicResource Surface}" CornerRadius="13" Padding="17,13"><StackPanel><TextBlock Tag="main.hourly" Text="{DynamicResource main.hourly}" Foreground="{DynamicResource Muted}" FontSize="10"/>
        <TextBlock x:Name="HourlyText" Text="¥114.29" FontFamily="Bahnschrift" FontSize="24" Margin="0,7,0,0"/></StackPanel></Border>
       <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="13" Padding="17,13"><StackPanel><TextBlock Tag="main.month" Text="{DynamicResource main.month}" Foreground="{DynamicResource Muted}" FontSize="10"/>
        <TextBlock x:Name="MonthText" Text="¥2,214.29" FontFamily="Bahnschrift" FontSize="24" Margin="0,7,0,0"/></StackPanel></Border>
      </Grid>
      <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="15" Padding="17,15" Margin="0,12,0,0">
       <StackPanel>
        <Grid><TextBlock x:Name="GoalHeadingText" Tag="goal.heading" Text="{DynamicResource goal.heading}" FontSize="9" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="GoalPercentText" Text="73%" FontFamily="Bahnschrift" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><Button x:Name="PreviousGoalButton" Content="‹" ToolTip="{DynamicResource goal.previous}" Padding="6,0" Margin="8,0,3,0"/><Button x:Name="NextGoalButton" Content="›" ToolTip="{DynamicResource goal.next}" Padding="6,0"/></StackPanel></Grid>
        <Grid Margin="0,9,0,0"><TextBlock x:Name="GoalNameText" Tag="goal.default" Text="{DynamicResource goal.default}" FontSize="15" FontWeight="SemiBold" MaxWidth="310" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
         <TextBlock x:Name="GoalAmountText" Text="¥3,000" FontFamily="Bahnschrift" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/></Grid>
        <ProgressBar x:Name="GoalProgress" Height="3" Minimum="0" Maximum="100" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Stroke}" Margin="0,12,0,9"/>
        <TextBlock x:Name="GoalHintText" Tag="goal.estimateHelp" Text="{DynamicResource goal.estimateHelp}" FontSize="10" Foreground="{DynamicResource Muted}"/>
       </StackPanel>
      </Border>
      <TextBlock x:Name="FootnoteText" Tag="main.footnote" Text="{DynamicResource main.footnote}" Foreground="{DynamicResource Muted}" FontSize="9" Margin="2,12,0,0"/>
     </StackPanel>
    </StackPanel>
   </Viewbox>
     <Grid x:Name="HomeActions" Grid.Row="2" Margin="22,12,22,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button x:Name="PrivacyButton" Content="{DynamicResource mode.privacy}" ToolTip="{DynamicResource mode.privacyOnTip}" Margin="0,0,6,0"/><Button x:Name="MiniButton" Content="{DynamicResource mode.mini}" ToolTip="{DynamicResource mode.miniOnTip}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="DemoButton" Content="{DynamicResource main.demo}" ToolTip="{DynamicResource main.demoTip}" Margin="0,0,6,0"/><Button x:Name="SettingsButton" Content="{DynamicResource main.firstUse}" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" BorderThickness="0" Padding="14,8"/></StackPanel>
     </Grid>
  </Grid>
 </Border>
</Window>
