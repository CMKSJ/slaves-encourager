<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <AssemblyName>SlavesEncourager.Mac</AssemblyName>
    <StartupObject>SlavesEncourager.Mac.Program</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <Version>1.5.0-beta.4</Version>
    <PublishTrimmed>false</PublishTrimmed>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <Compile Include="../SlavesEncourager/Engine.cs" Link="Shared/Engine.cs" />
    <Compile Include="../SlavesEncourager/Localization.cs" Link="Shared/Localization.cs" />
    <Compile Include="../SlavesEncourager/Stocks.cs" Link="Shared/Stocks.cs" />
    <Compile Include="../../tests/EngineTests.cs" Link="Checks/EngineTests.cs" />
    <Compile Include="../../tests/StockTests.cs" Link="Checks/StockTests.cs" />
    <EmbeddedResource Include="../../locales/catalog.tsv" LogicalName="Locales.tsv" />
    <EmbeddedResource Include="../../assets/app.png" LogicalName="AppIcon.png" />
  </ItemGroup>
</Project>
